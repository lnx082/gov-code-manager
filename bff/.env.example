# ===============================================
# 党政软件版本管控平台 BFF 环境配置
# ===============================================

# 服务器端口
PORT=8080
NODE_ENV=development

# 数据库配置 (选择一种)
# 方案1: SQLite (Gitea 数据库)
DB_TYPE=sqlite
DB_FILENAME=/home/git/data/gitea.db

# 方案2: PostgreSQL
# DB_TYPE=postgres
# DB_HOST=123.60.219.19
# DB_PORT=5432
# DB_NAME=gov_code_manager
# DB_USER=postgres
# DB_PASSWORD=your_password_here

# Gitea 配置
GITEA_URL=http://123.60.219.19:3000
GITEA_API_VERSION=v1

# JWT 配置 (生产环境必须修改)
JWT_SECRET=gov_code_manager_jwt_secret_key_2024_secure_change_in_production
JWT_EXPIRES_IN=7d

# 审计配置
AUDIT_LOG_ENABLED=true
AUDIT_LOG_RETENTION_DAYS=3650

# API 配置
BFF_API_PREFIX=/api/bff
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# 安全配置
BCRYPT_ROUNDS=10
SESSION_EXPIRY=604800
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=1800

# 日志配置
LOG_LEVEL=info
LOG_FORMAT=combined
